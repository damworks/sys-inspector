# Copy to .env (never commit it) and fill in.
# Use absolute paths: ~/.ssh is mounted in the container at the same path as on the host,
# so the same paths work both locally and in Docker.

SSH_KNOWN_HOSTS=/home/youruser/.ssh/known_hosts

# --- staging ---
STAGING_SSH_HOST=staging.example.com
STAGING_SSH_PORT=22
STAGING_SSH_USER=deploy
STAGING_SSH_KEY_PATH=/home/youruser/.ssh/id_ed25519
STAGING_SSH_KEY_PASSPHRASE=
STAGING_APP_DIR=/var/www/my_project
# true = DB reached through the SSH tunnel. Then DB_HOST/DB_PORT are resolved BY THE SSH SERVER:
#   127.0.0.1 if MySQL runs on the SSH server itself, otherwise the DB's internal host (e.g. db-staging.internal).
STAGING_DB_TUNNEL=true
STAGING_DB_HOST=127.0.0.1
STAGING_DB_PORT=3306
STAGING_DB_NAME=db
STAGING_DB_USER=readonly
STAGING_DB_PASSWORD=change-me

# --- production ---
PROD_SSH_HOST=prod.example.com
PROD_SSH_PORT=22
PROD_SSH_USER=deploy
PROD_SSH_KEY_PATH=/home/youruser/.ssh/id_ed25519
PROD_SSH_KEY_PASSPHRASE=
PROD_APP_DIR=/var/www/my_project
PROD_DB_TUNNEL=false
PROD_DB_HOST=db-prod.example.com
PROD_DB_PORT=3306
PROD_DB_NAME=db
PROD_DB_USER=readonly
PROD_DB_PASSWORD=change-me
